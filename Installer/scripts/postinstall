#!/bin/sh
# Після встановлення: запустити програму від імені користувача, який зараз за комп'ютером
# (сам установщик працює від root).
USER_NAME=$(stat -f %Su /dev/console)
if [ -n "$USER_NAME" ] && [ "$USER_NAME" != "root" ]; then
    USER_ID=$(id -u "$USER_NAME")
    launchctl asuser "$USER_ID" sudo -u "$USER_NAME" open "/Applications/Screenshoter.app"
fi
exit 0
